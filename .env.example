# Copy to .env.local and fill in what you have. Empty values stay hidden.
# Enquiry form on Vercel: only the server variables below are needed.
# Set VITE_ENQUIRY_ENDPOINT only to use another service such as Formspree.
VITE_ENQUIRY_ENDPOINT=
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_LOCATION=
VITE_INSTAGRAM_URL=
VITE_TIKTOK_URL=
