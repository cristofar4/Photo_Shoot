# Copy to .env.local and fill in what you have. Empty values stay hidden.
# Enquiry form. On Vercel use /api/enquiry together with the Resend keys below.
VITE_ENQUIRY_ENDPOINT=
# Server only (never prefixed with VITE_)
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_LOCATION=
VITE_INSTAGRAM_URL=
VITE_TIKTOK_URL=
